<?xml version="1.0" encoding="utf-8"?>
<registry>
  <records interface="collective.bbcodesnippets.controlpanel.IBBCodeSnippetsSettings"
           prefix="bbcodesnippets"
  />

  <records interface="plone.base.interfaces.resources.IBundleRegistry"
           prefix="plone.bundles/collective-bbcodesnippets-app"
  >
    <value key="jscompilation">++plone++collective.bbcodesnippets/collective.bbcodesnippets.js</value>
    <value key="csscompilation" />
    <value key="depends">plone</value>
    <value key="enabled">False</value>
    <value key="expression">python: member is not None</value>
  </records>

  <record field="custom_plugins"
          interface="plone.base.interfaces.controlpanel.ITinyMCESchema"
          name="plone.custom_plugins"
  >
    <value purge="False">
      <element>collectivebbcodesnippets|++plone++collective.bbcodesnippets/collective.bbcodesnippets.js</element>
    </value>
  </record>

</registry>
